{
  "author": "AckAgent",
  "dependencies": {
    "@ackagent/api": "^0.3.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "openapi-fetch": "^0.17.0"
  },
  "description": "TypeScript SDK for AckAgent - web-based authentication and signing with iOS Secure Enclave keys",
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICES"
  ],
  "keywords": [
    "ackagent",
    "signing",
    "secure-enclave",
    "x25519",
    "chacha20-poly1305",
    "end-to-end-encryption"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AckAgent/web-sdk.git"
  },
  "main": "./dist/index.js",
  "name": "@ackagent/web-sdk",
  "scripts": {
    "build": "tsc && pnpm copy:bbs-wasm",
    "clean": "rm -rf dist",
    "copy:bbs-wasm": "mkdir -p dist/generated/bbs_ffi_wasm && cp src/generated/bbs_ffi_wasm/* dist/generated/bbs_ffi_wasm/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "lint": "biome lint src/",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mattrglobal/pairing-crypto": "^0.4.2"
  },
  "peerDependenciesMeta": {
    "@mattrglobal/pairing-crypto": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.3.0",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
